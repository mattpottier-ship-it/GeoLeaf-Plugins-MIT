{
    "name": "@geoleaf/connector",
    "version": "1.2.4",
    "type": "module",
    "license": "MIT",
    "description": "GeoLeaf Connector Plugin — Universal fetch interceptor for authenticated GeoJSON, FlatGeobuf, KML, CSV and OGC API data sources",
    "main": "dist/geoleaf-connector.plugin.js",
    "module": "dist/geoleaf-connector.plugin.js",
    "exports": {
        ".": {
            "import": "./dist/geoleaf-connector.plugin.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist/",
        "src/",
        "LICENSE",
        "README.md"
    ],
    "scripts": {
        "clean": "rimraf dist",
        "build": "rollup -c",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "prepublishOnly": "npm run build"
    },
    "dependencies": {
        "@geoleaf/core": "*"
    },
    "devDependencies": {
        "@rollup/plugin-node-resolve": "^16.0.3",
        "@rollup/plugin-replace": "^6.0.3",
        "@rollup/plugin-typescript": "^12.1.2",
        "@vitest/coverage-istanbul": "^3.2.4",
        "@vitest/coverage-v8": "^3.2.4",
        "rimraf": "^5.0.5",
        "rollup": "^4.12.0",
        "typescript": "^5.8.2",
        "vitest": "^3.2.4"
    },
    "publishConfig": {
        "registry": "https://registry.npmjs.org",
        "access": "public"
    }
}
