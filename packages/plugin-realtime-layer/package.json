{
    "name": "@geoleaf-plugins/realtime-layer",
    "version": "1.0.0",
    "type": "module",
    "license": "MIT",
    "description": "GeoLeaf Realtime Layer Plugin — Generic real-time layer updates via polling, WebSocket and SSE",
    "main": "dist/geoleaf-realtime-layer.plugin.js",
    "module": "dist/geoleaf-realtime-layer.plugin.js",
    "exports": {
        ".": {
            "import": "./dist/geoleaf-realtime-layer.plugin.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist/",
        "src/",
        "LICENSE",
        "README.md"
    ],
    "scripts": {
        "clean": "rimraf dist",
        "build": "rollup -c",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "prepublishOnly": "npm run build"
    },
    "dependencies": {
        "@geoleaf/core": "*",
        "gtfs-realtime-bindings": "^1.1.1"
    },
    "devDependencies": {
        "@rollup/plugin-commonjs": "^28.0.3",
        "@rollup/plugin-json": "^6.1.0",
        "@rollup/plugin-node-resolve": "^16.0.3",
        "@rollup/plugin-replace": "^6.0.3",
        "@rollup/plugin-typescript": "^12.1.2",
        "@vitest/coverage-istanbul": "^3.2.4",
        "@vitest/coverage-v8": "^3.2.4",
        "rimraf": "^5.0.5",
        "rollup": "^4.12.0",
        "typescript": "^5.8.2",
        "vitest": "^3.2.4"
    },
    "publishConfig": {
        "registry": "https://registry.npmjs.org",
        "access": "public"
    }
}
