{
    "name": "@geoleaf-plugins/file-import",
    "version": "1.0.0",
    "type": "module",
    "license": "MIT",
    "description": "GeoLeaf File Import Plugin — Convert and import GPX, KML, KMZ, CSV, TopoJSON files as GeoJSON layers",
    "bundleSize": "276 KB raw / 70 KB gzip (separate from core — no impact on core budget)",
    "main": "dist/geoleaf-file-import.plugin.js",
    "module": "dist/geoleaf-file-import.plugin.js",
    "exports": {
        ".": {
            "import": "./dist/geoleaf-file-import.plugin.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist/",
        "src/",
        "LICENSE",
        "README.md"
    ],
    "scripts": {
        "clean": "rimraf dist",
        "build": "rollup -c",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "prepublishOnly": "npm run build"
    },
    "dependencies": {
        "@geoleaf/core": "*",
        "@mapbox/togeojson": "^0.16.2",
        "fflate": "^0.8.2",
        "papaparse": "^5.4.1",
        "topojson-client": "^3.1.0"
    },
    "devDependencies": {
        "@rollup/plugin-commonjs": "^28.0.3",
        "@rollup/plugin-json": "^6.1.0",
        "@rollup/plugin-node-resolve": "^16.0.3",
        "@rollup/plugin-replace": "^6.0.3",
        "@rollup/plugin-typescript": "^12.1.2",
        "@types/geojson": "^7946.0.14",
        "@types/papaparse": "^5.3.14",
        "@types/topojson-client": "^3.1.4",
        "@vitest/coverage-istanbul": "^3.2.4",
        "@vitest/coverage-v8": "^3.2.4",
        "happy-dom": "^20.9.0",
        "rimraf": "^5.0.5",
        "rollup": "^4.12.0",
        "typescript": "^5.8.2",
        "vitest": "^3.2.4"
    },
    "publishConfig": {
        "registry": "https://registry.npmjs.org",
        "access": "public"
    }
}
